{
  "name": "maheshwar-rao-bandi-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "preview": "opennextjs-cloudflare build --openNextConfigPath open-next.config.mjs && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --openNextConfigPath open-next.config.mjs && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply portfolio --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio --remote",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:assets": "node scripts/generate-assets.mjs",
    "generate:resume": "node scripts/generate-resume.mjs",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "motion": "^12.42.2",
    "next": "^16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "pdfkit": "^0.19.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "wrangler": "^4.166.0"
  }
}
